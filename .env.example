# LLM Provider Selection: "auto", "groq", or "gemini"
LLM_PROVIDER=auto

# Groq API Key (obtain from Groq Console: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# LLM Reasoning Settings
MAX_CANDIDATES_FOR_LLM=5
LLM_TEMPERATURE=0.2

# Application Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=https://restosearchbengaluru.onrender.com
DEBUG=True

# Data paths (relative to workspace root)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
PROCESSED_DATA_FILE=data/processed/zomato_cleaned.parquet
